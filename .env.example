# MT Group Quote Builder — environment variables (build brief §7).
# Copy to `.env` and fill in. Never commit real values.

# Postgres connection string (Vercel Postgres / Neon).
DATABASE_URL=

# HubSpot Private App token, portal 7423331, scope crm.objects.deals.read.
# Created by a HubSpot admin under Settings → Integrations → Private Apps.
HUBSPOT_PRIVATE_APP_TOKEN=

# Auth.js (magic-link email sign-in, allowlisted to the MTG team).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Transactional email for magic-link delivery.
# Either an SMTP connection string, or swap for RESEND_API_KEY if using Resend.
EMAIL_SERVER=
EMAIL_FROM=
