# MT Group Quote Builder — environment variables (build brief §7).
# Copy to `.env` and fill in. Never commit real values.

# Postgres connection string used by the running app.
# On Neon, use the POOLED string — its host contains "-pooler".
#
# Prefer `sslmode=verify-full` over the `sslmode=require` Neon hands out.
# Today the driver treats them the same (it verifies the certificate either
# way), but a future major version will downgrade `require` to encrypt-without-
# verifying. Spelling out verify-full keeps the certificate check permanently.
DATABASE_URL=

# The same database, direct (unpooled) — used only by `prisma migrate`.
# On Neon this is the pooled string with "-pooler" removed from the host.
# Leave blank for a local Postgres with no connection pooler.
DIRECT_URL=

# HubSpot Private App token, portal 7423331, scope crm.objects.deals.read.
# Created by a HubSpot admin under Settings → Integrations → Private Apps.
HUBSPOT_PRIVATE_APP_TOKEN=

# Auth.js (magic-link email sign-in, allowlisted to the MTG team).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Transactional email for magic-link delivery.
# Either an SMTP connection string, or swap for RESEND_API_KEY if using Resend.
EMAIL_SERVER=
EMAIL_FROM=
